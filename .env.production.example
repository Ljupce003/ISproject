# Copy to .env.production on the VM. Never commit real credentials.
# Use matching app/migration release tags from the same source revision.
APP_IMAGE=your-dockerhub-user/isproject-app:1.0.0
MIGRATION_IMAGE=your-dockerhub-user/isproject-migrations:1.0.0
APP_HOST=isproject.example.com
API_KEY=

DB_DATABASE=isproject
DB_USERNAME=isproject
# Generate a production password: openssl rand -hex 32
DB_PASSWORD=
ISPROJECT_DB_PORT=8003

# Native Nginx reaches the container via this network's bridge gateway.
# Change the subnet if it overlaps another Docker/VM network, and adjust trust too.
APP_NETWORK_SUBNET=172.30.81.0/24
TRUSTED_PROXY_CIDRS=172.30.81.1/32
ISPROJECT_HTTP_PORT=8001
# Docker Nginx: append its IP/CIDR on web-proxy to TRUSTED_PROXY_CIDRS.
